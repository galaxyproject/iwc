"tool_state": "{\"code\": \"NR > 1 {print $1}\", \"infile\": {\"__class__\": \"ConnectedValue\"}, \"variables\": [], \"__page__\": 0, \"__rerun_remap_job_id__\": null}", "tool_uuid": null, "tool_version": "9.5+galaxy3", "type": "tool", "uuid": "a9919bd8-ad50-4cb3-b7a2-f45b5ede696b", "when": null, "workflow_outputs": []}, "65": {"annotation": "Drop bins without a CheckM2 quality result, so dRep cannot fail on them.", "content_id": "__FILTER_FROM_FILE__", "errors": null, "id": 65, "input_connections": {"input": {"id": 32, "output_name": "output"}, "how|filter_source": {"id": 64, "output_name": "outfile"}}, "inputs": [], "label": "Keep bins with CheckM2 quality information", "name": "Filter collection", "outputs": [], "position": {"left": 4140, "top": 1620}, "post_job_actions": {"HideDatasetActionoutput_discarded": {"action_arguments": {}, "action_type": "HideDatasetAction", "output_name": "output_discarded"}, "HideDatasetActionoutput_filtered": {"action_arguments": {}, "action_type": "HideDatasetAction", "output_name": "output_filtered"}}, "tool_id": "__FILTER_FROM_FILE__", "tool_state": "{\"how\": {\"how_filter\": \"remove_if_absent\", \"__current_case__\": 0, \"filter_source\": {\"__class__\": \"ConnectedValue\"}}, \"input\": {\"__class__\": \"ConnectedValue\"}, \"__page__\": 0, \"__rerun_remap_job_id__\": null}", "tool_uuid": null, "tool_version": "1.0.0", "type": "tool", "uuid": "1c7130f9-76ed-464b-91b2-cf50f5e218b9", "when": null, "workflow_outputs": []}, "66": {"type": "subworkflow", "name": "Assembly and assembly selection", "label": "Assembly and assembly selection", "tool_id": null, "tool_state": "{}", "subworkflow": {"a_galaxy_workflow": "true", "annotation": "This workflow performs metagenomic assembly of paired-end short reads with MEGAHIT or metaSPAdes (optionally adding Nanopore or PacBio long reads to metaSPAdes), or takes custom assemblies, and evaluates the assemblies with QUAST. It is designed as a reusable building block for larger metagenomic analysis workflows such as MAGs generation.", "comments": [], "creator": [{"class": "Person", "identifier": "https://orcid.org/0009-0004-0382-2023", "name": "Santino Faack"}, {"class": "Person", "identifier": "https://orcid.org/0000-0003-2982-388X", "name": "Paul Zierep"}, {"class": "Organization", "name": "FAIRyMAGs consortium", "url": "https://github.com/usegalaxy-eu/FAIRyMAGs"}], "format-version": "0.1", "license": "MIT", "name": "Metagenomic Assembly", "report": {"markdown": "\n# Workflow Execution Report\n\n## Workflow Inputs\n```galaxy\ninvocation_inputs()\n```\n\n## Workflow Outputs\n```galaxy\ninvocation_outputs()\n```\n\n## Workflow\n```galaxy\nworkflow_display()\n```\n"}, "steps": {"0": {"annotation": "", "content_id": "toolshed.g2.bx.psu.edu/repos/bgruening/text_processing/tp_text_file_with_recurring_lines/9.11+galaxy0", "errors": null, "id": 0, "input_connections": {}, "inputs": [], "label": "create text file", "name": "Create text file", "outputs": [{"name": "outfile", "type": "txt"}], "position": {"left": 600, "top": 530}, "post_job_actions": {}, "tool_id": "toolshed.g2.bx.psu.edu/repos/bgruening/text_processing/tp_text_file_with_recurring_lines/9.11+galaxy0", "tool_shed_repository": {"changeset_revision": "30b60202d990", "name": "text_processing", "owner": "bgruening", "tool_shed": "toolshed.g2.bx.psu.edu"}, "tool_state": "{\"token_set\": [{\"__index__\": 0, \"line\": null, \"repeat_select\": {\"repeat_select_opts\": \"user\", \"__current_case__\": 0, \"times\": \"1\"}}], \"__page__\": 0, \"__rerun_remap_job_id__\": null}", "tool_uuid": null, "tool_version": "9.11+galaxy0", "type": "tool", "uuid": "bc1dfdf3-1377-4475-bb36-e262a2fd6ced", "when": null, "workflow_outputs": []}, "1": {"annotation": "Samples grouped for co-assembly, one paired element per group. For individual assembly, provide one element per sample. The tool fastq_groupmerge can be used to perform the grouping.", "content_id": null, "errors": null, "id": 1, "input_connections": {}, "inputs": 