t_name": "bins"}, "TagDatasetActioncontigs2bin": {"action_arguments": {"tags": "das-tool-conitgs2bin-report"}, "action_type": "TagDatasetAction", "output_name": "contigs2bin"}, "TagDatasetActionsummary": {"action_arguments": {"tags": "das-tool-summary"}, "action_type": "TagDatasetAction", "output_name": "summary"}}, "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/das_tool/das_tool/1.1.7+galaxy1", "tool_shed_repository": {"changeset_revision": "b048a987dd7d", "name": "das_tool", "owner": "iuc", "tool_shed": "toolshed.g2.bx.psu.edu"}, "tool_state": "{\"adv\": {\"search_engine\": \"diamond\", \"proteins\": null, \"score_threshold\": \"0.5\", \"duplicate_penalty\": \"0.6\", \"megabin_penalty\": \"0.5\", \"max_iter_post_threshold\": \"10\"}, \"binning\": [{\"__index__\": 0, \"bins\": {\"__class__\": \"ConnectedValue\"}, \"labels\": \"CONCOCT\"}, {\"__index__\": 1, \"bins\": {\"__class__\": \"ConnectedValue\"}, \"labels\": \"COMEBin\"}, {\"__index__\": 2, \"bins\": {\"__class__\": \"ConnectedValue\"}, \"labels\": \"MetaBAT2\"}, {\"__index__\": 3, \"bins\": {\"__class__\": \"ConnectedValue\"}, \"labels\": \"MaxBin2\"}, {\"__index__\": 4, \"bins\": {\"__class__\": \"ConnectedValue\"}, \"labels\": \"SemiBin\"}], \"contigs\": {\"__class__\": \"ConnectedValue\"}, \"output\": {\"proteins\": false, \"write_bin_evals\": false, \"write_bins\": {\"write_bins\": \"--write_bins\", \"__current_case__\": 0, \"write_unbinned\": false}, \"debug\": false}, \"__page__\": 0, \"__rerun_remap_job_id__\": null}", "tool_uuid": null, "tool_version": "1.1.7+galaxy1", "type": "tool", "uuid": "35408f05-b203-4c65-b4ef-80ebfbbe1d58", "when": "$(inputs.when)", "workflow_outputs": [{"label": "DAS Tool bins", "output_name": "bins", "uuid": "f6517089-9d22-4513-97e1-4268a3ad2766"}, {"label": "DAS Tool contigs2bin report", "output_name": "contigs2bin", "uuid": "6e55e68d-96e7-4898-b6ae-f1110ea764a8"}, {"label": "DAS Tool summary", "output_name": "summary", "uuid": "47867014-9b39-493e-8aac-5350afa6792f"}]}, "53": {"annotation": "Refine candidate FASTA bins using CheckM2 quality estimates and the selected completeness and contamination settings.", "content_id": "toolshed.g2.bx.psu.edu/repos/iuc/binette/binette/1.2.1+galaxy0", "errors": null, "id": 53, "input_connections": {"contig2bin_tables": {"id": 51, "output_name": "output"}, "contigs": {"id": 0, "output_name": "output"}, "database_type|datamanager": {"id": 8, "output_name": "output"}, "when": {"id": 50, "output_name": "output_param_boolean"}, "min_completeness": {"id": 9, "output_name": "output"}, "contamination_weight": {"id": 10, "output_name": "output"}}, "inputs": [{"description": "runtime parameter for tool Binette", "name": "database_type"}], "label": "Refine candidate bins with Binette", "name": "Binette", "outputs": [{"name": "bins", "type": "input"}, {"name": "quality", "type": "input"}, {"name": "final", "type": "tabular"}], "position": {"left": 5400, "top": 1620}, "post_job_actions": {"TagDatasetActionbins": {"action_arguments": {"tags": "binette-bins"}, "action_type": "TagDatasetAction", "output_name": "bins"}, "TagDatasetActionfinal": {"action_arguments": {"tags": "binette-post-quality-reports"}, "action_type": "TagDatasetAction", "output_name": "final"}, "TagDatasetActionquality": {"action_arguments": {"tags": "binette-pre-quality-reports"}, "action_type": "TagDatasetAction", "output_name": "quality"}}, "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/binette/binette/1.2.1+galaxy0", "tool_shed_repository": {"changeset_revision": "9053a39d7994", "name": "binette", "owner": "iuc", "tool_shed": "toolshed.g2.bx.psu.edu"}, "tool_state": "{\"contamination_weight\": {\"__class__\": \"ConnectedValue\"}, \"contig2bin_tables\": {\"__class__\": \"ConnectedValue\"}, \"contigs\": {\"__class__\": \"ConnectedValue\"}, \"database_type\": {\"is_select\": \"cached\", \"__current_case__\": 1, \"datamanager\": {\"__class__\": \"ConnectedValue\"}}, \"min_completeness\": {\"__class__\": \"ConnectedValue\"}, \"proteins\": null, \"__page__\": 0, \"__rerun_remap_job_id__\": null}", "tool_uuid": null, "tool_version": "1.2.1+galaxy0", "type": "tool", "uuid": "43c8ccb8-6c5f-4b64-87e1-1bd641f97079", "when": "$(inputs.when)", "workflow_outputs": [{"label": "Binette input bin quality reports", "output_name": "quality", "uuid": "99e64da5-8e80-4eb9-a931-289055ec717e"}, {"label": "Binette bins", "output_name": "bins", "uuid": "78d973e2-680e-4541-9920-4a08489125da"}, {"label": "Binette final bin quality report", "output_name": "final", "uuid": "a10382ed-1d4b-45ad-89b5-79cd5041ec66"}]}}, "tags": ["agentic-foundry-mags"], "uuid": "9b674961-0b3c-4f8f-97e6-f225e018198f", "version": 1, "readme": "# Multi-sample binning workflow\n\nThis workflow turns metagenomic assemblies into metagenomic bins with five binners (CONCOCT, MaxBin2, MetaBAT2, SemiBin and COMEBin), using cross-sample read coverage, and refines the bins with DAS Tool and/or Binette.\n\nIt performs cross-sample coverage estimation, binning and bin refinement for the [MAGs generation workflow](https://iwc.galaxyproject.org/workflow/mags-building-main/).\nA dedicated [learning pathway](https://galaxyproject.github.io/training-material/learning-pathways/mags.html) provides detailed guidance on MAG generation in Galaxy, including the binning tools used here.\n\n## How multi-sample binning works\n\nIn single-sample binning, each assembly is binned with the coverage of its own reads. In multi-sample binning, the reads of every sample are mapped against the assembly of every sample, so each contig gets one coverage profile per sample. Binners can then separate organisms that have similar composition but different abundance patterns across samples.\n\nTwo details are worth knowing before starting:\n\n- Each sample's reads are mapped against each sample's assembly, and every assembly is binned on its own. The workflow does not concatenate all assemblies into one co-assembly and split the resulting bins afterwards.\n- The mapping workload grows as N\u00b2 for N samples: N read sets \u00d7 N assemblies. Storage grows quickly too, even though the workflow reuses the original FASTQ datasets instead of writing intermediate read files.\n\n**Note on sample count:** Multi-sample binning is most effective with up to ~20 samples. Performance usually peaks around 20 samples ([Mineeva et al., *Nat. Commun.* 2025](https://www.nature.com/articles/s41467-026-71521-w)). Using more than 20 samples can lead to extensive resource usage (N\u00b2 mappings and substantial storage requirements). For many samples or samples from unrelated environments where cross-sample coverage adds little, [single-sample binning](https://iwc.galaxyproject.org/workflow/single-sample-binning-main/) is often the cheaper choice.\n\n## Inputs\n\n- **Assemblies**: a `list` collection of assemblies from any assembler (e.g. MEGAHIT or metaSPAdes).\n  - Every sample's reads are mapped against every assembly, so the element identifiers of the reads and assemblies do not need to match.\n  - The number of assemblies does not need to equal the number of read samples: a single co-assembly binned with the coverage of all samples is a valid input.\n- **Paired-end reads**: a `list:paired` collection with one element per sample.\n  - Reads should be quality-trimmed and host-removed, e.g. with the IWC [short-read quality control](https://iwc.galaxyproject.org/workflow/short-read-qc-trimming-main/) and [host contamination removal](https://iwc.galaxyproject.org/workflow/host-contamination-removal-short-reads-main/) workflows.\n  - The sample names become the coverage columns of the binners.\n  - **Use with caution for large datasets:** multi-sample binning is most effective with up to ~20 samples. Performance usually peaks around 20 samples ([Mineeva et al., *Nat. Commun.* 2025](https://www.nature.com/articles/s41467-026-71521-w)). Using more than 20 samples can lead to extensive resource usage, as the mapping workload grows as N\u00b2 (N read sets \u00d7 N assemblies) and storage requirements increase substantially. For many samples or unrelated environments, [single-sample binning](https://iwc.galaxyproject.org/workflow/single-sample-binning-main/) is often the cheaper choice.\n- **Run COMEBin?**, **Run SemiBin?**, **Run CONCOCT?**, **Run MetaBAT2?** and **Run MaxBin2?** (default: `Yes`): enable or skip each binner independently.\n  - Keep at least one binner enabled.\n  - COMEBin is the most time- and resource-consuming binner.\n- **Bin refinement tool** (default: `Binette`): `Binette`, `DAS Tool` or `Both`.\n- **CheckM2 Database**: the CheckM2 reference database Binette uses to assess bin quality.\n- **Minimum MAG completeness percentage** (default: 40): the minimum bin completeness used by Binette. It does not filter DAS Tool output.\n- **Contamination weight (Binette)** (default: 2): the contamination penalty used in Binette's scoring.\n\n## Step 1: Coverage\n\nThis step produces the coverage information every binner needs.\n\n1. The read pairs of all samples are flattened into one flat list of files, and the assemblies are used as they are.\n2. A nested cross product pairs each assembly with every flattened read file.\n3. Apply Rules rebuilds, for each assembly, the paired reads of each sample and the matching assembly reference. These are collection operations on the original datasets: no interlaced or de-interlaced FASTQ file is written.\n4. Bowtie2 maps every sample against every assembly.\n5. Contig depths are summarised per assembly with `jgi_summarize_bam_contig_depths`, which yields one coverage matrix per assembly with the coverage and variance of every sample.\n6. CONCOCT additionally needs the coverage of its contig fragments, which is computed separately, and the mean read length, which is estimated from both mates of every sample with SeqKit statistics. The estimate is the read-count-weighted mean (total bases divided by total reads), not an average of the per-sample means. No manual read length is required.\n\nThe depth table produced by `jgi_summarize_bam_contig_depths` starts with `contigName` (contig identifier), `contigLen` (contig length) and `totalAvgDepth` (average depth across the input BAM files). Each read sample then contributes a depth column and a variance column. This gives each assembly's contigs a coverage profile across all read samples; \u201cJGI depth table\u201d refers to this format, not to an additional input database.\n\n## Step 2: Binning\n\nEach assembly is binned separately by every enabled binner.\n\n| Binner | Inputs used |\n| --- | --- |\n| SemiBin | Contig composition and cross-sample coverage, in co-binning mode |\n| CONCOCT | Contig fragments, their coverage table and the estimated read length; fragment clusters are merged back to contigs |\n| MetaBAT2 | Contig composition and cross-sample coverage |\n| MaxBin2 | Contig composition, cross-sample coverage and marker genes |\n| COMEBin | Deep-learning binning from contig sequence and coverage; optional |\n\nA binner set to `No` is skipped, and its candidate results are replaced by empty collections so that the refinement steps keep their structure. Raw binner outputs are only available for binners that ran.\n\n## Step 3: Refinement\n\nThe candidate bins are refined with one or both refinement tools:\n\n- **DAS Tool** scores the contig-to-bin assignments of all enabled binners and selects a non-redundant set of bins.\n- **Binette** evaluates the candidate FASTA bins with CheckM2 and refines them with the selected completeness and contamination settings.\n\nSelecting **Both** runs DAS Tool and Binette independently on the candidate bins, allowing you to benefit from their different refinement approaches. The two output sets must then be combined and dereplicated downstream; this workflow does not perform dereplication. Dereplication reduces redundant genomes but does not enforce unique contig membership, so contigs can still end up in multiple retained bins. If exclusive contig assignments are required, inspect and resolve overlaps explicitly.\n\n## Outputs\n\n- **Coverage depth matrices**: one depth table per assembly, with the coverage of all original samples.\n- **CONCOCT bins**, **MaxBin2 bins**, **MetaBAT2 bins**, **SemiBin bins** and **COMEBin bins** (when COMEBin ran): one list of bins per assembly.\n- **DAS Tool bins**, **DAS Tool summary** and **DAS Tool contigs2bin report** (when DAS Tool ran): the refined bins, a per-bin summary of completeness and redundancy based on single-copy genes, and the contig-to-bin assignments.\n- **Binette bins**, **Binette input bin quality reports** and **Binette final bin quality report** (when Binette ran): the refined bins, the CheckM2 quality of the bins from each binner, and the CheckM2 quality of the final bins.\n\n## Why use this workflow\n\nBinning is a separate workflow here, so it can be reused by larger analysis pipelines without copying or rewiring it.\n\n- It keeps the binning parameters and outputs visible and controllable.\n- It can be combined with different upstream and downstream workflows, e.g. taxonomic classification, genome annotation, functional analysis or benchmarking.\n- It avoids duplicating binning logic inside every pipeline that needs it.\n\nThe IWC [MAGs generation workflow](https://iwc.galaxyproject.org/workflow/mags-building-main/) is the comprehensive alternative: it assembles reads, bins with multiple tools, dereplicates the MAGs and reports their quality and abundance in one workflow. Use it when you want MAGs and their evaluation without a specialised downstream workflow, and use this binning workflow when binning is one component of a larger analysis.\n\nThrough the workflow editor, an upstream or downstream workflow can also restrict this one, for example to a single refinement tool.\n\n## Funding\n\nThis workflow was developed as part of the [**FAIRyMAGs** project](https://elixir-europe.org/how-we-work/scientific-programme/science/bfsp/fairymags), funded as a commissioned service of the [**Biodiversity, Food Security and Pathogens (BFSP) ELIXIR Scientific Programme 2024\u20132028**](https://elixir-europe.org/how-we-work/scientific-programme/science/bfsp).\n\nThe project was also supported by the **European Galaxy Server**, funded by the German Federal Ministry of Education and Research (BMBF; 031 A538A de.NBI-RBC) and the **Ministry of Science, Research and the Arts Baden-W\u00fcrttemberg (MWK)** within the framework of **LIBIS/de.NBI Freiburg**.\n"}, "input_connections": {"Paired-end reads": {"id": 0, "output_name": "output", "input_subworkflow_step_id": 0}, "Assemblies": {"id": 66, "output_name": "Selected assemblies", "input_subworkflow_step_id": 1}, "Run COMEBin?": {"id": 10, "output_name": "output", "input_subworkflow_step_id": 2}, "Bin refinement tool": {"id": 16, "output_name": "output", "input_subworkflow_step_id": 4}, "CheckM2 Database": {"id": 17, "output_name": "output", "input_subworkflow_step_id": 5}, "Run SemiBin?": {"id": 11, "output_name": "output", "input_subworkflow_step_id": 39}, "Run CONCOCT?": {"id": 12, "output_name": "output", "input_subworkflow_step_id": 40}, "Run MetaBAT2?": {"id": 13, "output_name": "output", "input_subworkflow_step_id": 41}, "Run MaxBin2?": {"id": 14, "output_name": "output", "input_subworkflow_step_id": 42}, "Minimum MAG completeness percentage": {"id": 18, "output_name": "output", "input_subworkflow_step_id": 49}, "Contamination weight (Binette)": {"id": 19, "output_name": "output", "input_subworkflow_step_id": 50}, "when": {"id": 54, "output_name": "output_param_boolean"}}, "inputs": [], "outputs": [], "annotation": "Embedded workflow: bins every assembly with the coverage of all original samples.", "when": "$(inputs.when)", "id": 55, "uuid": "64df806b-3e82-433b-9d6b-b91991ec4a88", "position": {"left": 2450, "top": 1320}, "workflow_outputs": [{"label": "Multi-coverage binning (all samples) \u2014 DAS Tool bins", "output_name": "DAS Tool bins", "uuid": "37a93238-0070-46c3-b204-91b197d785cd"}, {"l