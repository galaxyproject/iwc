{
    "a_galaxy_workflow": "true",
    "annotation": "This workflow performs metagenomic assembly of paired-end short reads with MEGAHIT or metaSPAdes (optionally adding Nanopore or PacBio long reads to metaSPAdes), or takes custom assemblies, and evaluates the assemblies with QUAST. It is designed as a reusable building block for larger metagenomic analysis workflows such as MAGs generation.",
    "comments": [],
    "creator": [
        {
            "class": "Person",
            "identifier": "https://orcid.org/0009-0004-0382-2023",
            "name": "Santino Faack"
        },
        {
            "class": "Person",
            "identifier": "https://orcid.org/0000-0003-2982-388X",
            "name": "Paul Zierep"
        }
    ],
    "format-version": "0.1",
    "license": "MIT",
    "release": "1.0",
    "name": "Metagenomic Assembly",
