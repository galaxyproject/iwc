      "subworkflow": {
        "a_galaxy_workflow": "true",
        "annotation": "This workflow performs metagenome assembly and multi-tool binning of paired short reads and optional long reads to generate dereplicated Metagenome-Assembled Genomes (MAGs), and analyzes them for quality and abundance.",
        "comments": [
          {
            "id": 0,
            "type": "markdown",
            "color": "blue",
            "position": [
              140,
              115
            ],
            "size": [
              380,
              260
            ],
            "data": {
              "text": "## 1. Inputs and controls\n\nSupply paired short reads and optional long reads. Metadata defines sample groups. Choose original, grouped or hybrid samples; single, multi or both coverage strategies; and Binette, DAS Tool or both refiners."
            }
          },
          {
            "id": 1,
            "type": "frame",
            "color": "blue",
            "position": [
              110,
              80
            ],
            "size": [
              430,
              7200
            ],
            "data": {
              "title": "Inputs and controls"
            },
            "child_steps": [
              71,
              72,
              73,
