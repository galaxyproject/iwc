    "101": {
      "type": "subworkflow",
      "name": "Quality control and trimming of short reads",
      "label": "Quality control and trimming of short reads",
      "tool_id": null,
      "tool_state": "{}",
      "input_connections": {
        "Raw reads": {
          "id": 0,
          "output_name": "output",
          "input_subworkflow_step_id": 0
        },
