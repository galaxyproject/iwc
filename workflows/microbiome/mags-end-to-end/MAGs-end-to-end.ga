 category abundances (eggNOG-mapper)", "uuid": "23a47e9e-263f-482b-9cc3-4f82f89418f2"}, {"label": "GO abundances (eggNOG-mapper)", "output_name": "GO abundances (eggNOG-mapper)", "uuid": "4a935596-6a17-487d-a447-ded60edae6d2"}, {"label": "EC abundances (eggNOG-mapper)", "output_name": "EC abundances (eggNOG-mapper)", "uuid": "f442bb79-9a1d-46f6-9fb6-8ad36b5c5305"}, {"label": "KEGG KO abundances (eggNOG-mapper)", "output_name": "KEGG KO abundances (eggNOG-mapper)", "uuid": "97f4988c-b8d2-45f1-9087-a3bcea482f3d"}, {"label": "KEGG pathway abundances (eggNOG-mapper)", "output_name": "KEGG pathway abundances (eggNOG-mapper)", "uuid": "7f9f3dc1-fb20-4daa-8071-c60e8b7fe636"}, {"label": "KEGG module abundances (eggNOG-mapper)", "output_name": "KEGG module abundances (eggNOG-mapper)", "uuid": "71d9c3b3-d388-45de-9f76-e03bf7b1b494"}, {"label": "KEGG reaction abundances (eggNOG-mapper)", "output_name": "KEGG reaction abundances (eggNOG-mapper)", "uuid": "1392a580-bd98-4cc4-bec8-2ca6d5c62c23"}, {"label": "KEGG rclass abundances (eggNOG-mapper)", "output_name": "KEGG rclass abundances (eggNOG-mapper)", "uuid": "84a42c96-2b8c-46f0-9eef-561b2d8ebb41"}, {"label": "BRITE abundances (eggNOG-mapper)", "output_name": "BRITE abundances (eggNOG-mapper)", "uuid": "35110603-cb05-4430-bbad-8587772e062f"}, {"label": "KEGG TC abundances (eggNOG-mapper)", "output_name": "KEGG TC abundances (eggNOG-mapper)", "uuid": "0e384493-5d94-436f-84c8-f0221878e774"}, {"label": "CAZy abundances (eggNOG-mapper)", "output_name": "CAZy abundances (eggNOG-mapper)", "uuid": "ef8feb05-c61d-45a0-b3de-6f0b3ce6b33b"}, {"label": "BiGG reaction abundances (eggNOG-mapper)", "output_name": "BiGG reaction abundances (eggNOG-mapper)", "uuid": "3563cfca-3214-42ce-a6cb-7bbad9294769"}, {"label": "PFAM abundances (eggNOG-mapper)", "output_name": "PFAM abundances (eggNOG-mapper)", "uuid": "af212049-0ee2-41ba-95b2-8b343b3ac676"}, {"label": "eggNOG-mapper annotation abundance table", "output_name": "eggNOG-mapper annotation abundance table", "uuid": "29f5958f-b10e-40de-8aaa-bf5f2e24e303"}]}}}, "tool_id": null, "type": "subworkflow", "uuid": "d12f3444-52fe-4a5a-9929-2ca17d92d1cb", "when": "$(inputs.when)", "workflow_outputs": [{"label": "eggNOG OG abundances (eggNOG-mapper)", "output_name": "eggNOG OG abundances (eggNOG-mapper)", "uuid": "c1dae832-5cf3-4c1f-a394-3f9bc8ad9cbd"}, {"label": "COG category abundances (eggNOG-mapper)", "output_name": "COG category abundances (eggNOG-mapper)", "uuid": "23a47e9e-263f-482b-9cc3-4f82f89418f2"}, {"label": "GO abundances (eggNOG-mapper)", "output_name": "GO abundances (eggNOG-mapper)", "uuid": "4a935596-6a17-487d-a447-ded60edae6d2"}, {"label": "EC abundances (eggNOG-mapper)", "output_name": "EC abundances (eggNOG-mapper)", "uuid": "f442bb79-9a1d-46f6-9fb6-8ad36b5c5305"}, {"label": "KEGG KO abundances (eggNOG-mapper)", "output_name": "KEGG KO abundances (eggNOG-mapper)", "uuid": "97f4988c-b8d2-45f1-9087-a3bcea482f3d"}, {"label": "KEGG pathway abundances (eggNOG-mapper)", "output_name": "KEGG pathway abundances (eggNOG-mapper)", "uuid": "7f9f3dc1-fb20-4daa-8071-c60e8b7fe636"}, {"label": "KEGG module abundances (eggNOG-mapper)", "output_name": "KEGG module abundances (eggNOG-mapper)", "uuid": "71d9c3b3-d388-45de-9f76-e03bf7b1b494"}, {"label": "KEGG reaction abundances (eggNOG-mapper)", "output_name": "KEGG reaction abundances (eggNOG-mapper)", "uuid": "1392a580-bd98-4cc4-bec8-2ca6d5c62c23"}, {"label": "KEGG rclass abundances (eggNOG-mapper)", "output_name": "KEGG rclass abundances (eggNOG-mapper)", "uuid": "84a42c96-2b8c-46f0-9eef-561b2d8ebb41"}, {"label": "BRITE abundances (eggNOG-mapper)", "output_name": "BRITE abundances (eggNOG-mapper)", "uuid": "35110603-cb05-4430-bbad-8587772e062f"}, {"label": "KEGG TC abundances (eggNOG-mapper)", "output_name": "KEGG TC abundances (eggNOG-mapper)", "uuid": "0e384493-5d94-436f-84c8-f0221878e774"}, {"label": "CAZy abundances (eggNOG-mapper)", "output_name": "CAZy abundances (eggNOG-mapper)", "uuid": "ef8feb05-c61d-45a0-b3de-6f0b3ce6b33b"}, {"label": "BiGG reaction abundances (eggNOG-mapper)", "output_name": "BiGG reaction abundances (eggNOG-mapper)", "uuid": "3563cfca-3214-42ce-a6cb-7bbad9294769"}, {"label": "PFAM abundances (eggNOG-mapper)", "output_name": "PFAM abundances (eggNOG-mapper)", "uuid": "af212049-0ee2-41ba-95b2-8b343b3ac676"}, {"label": "eggNOG-mapper annotation abundance table", "output_name": "eggNOG-mapper annotation abundance table", "uuid": "29f5958f-b10e-40de-8aaa-bf5f2e24e303"}]}}, "tags": [], "uuid": "e1e6ce2d-d7c5-45a6-93eb-d730768f7c06", "version": 1, "readme": "# Functional annotation of protein or DNA sequences Workflow\n\nThis workflow utilizes eggNOG mapper and InterProScan for the functional annotation of protein or DNA sequences.\nIt can be used on proteins or DNA from any organism.\n\nThis workflow can be used on its own or integrated into other workflows. For example, it is part of a **suite of workflows for end-to-end metagenome-assembled genome (MAG) generation** (check [FAIRyMAGs repository](https://github.com/usegalaxy-eu/FAIRyMAGs) for the complete workflow suite and its capabilities).\nA dedicated [learning pathway](https://galaxyproject.github.io/training-material/learning-pathways/mags.html) provides detailed guidance on how to use this workflow.\n\nEggNOG Mapper compares each protein sequence (or translated DNA sequence when nucleotide input is provided) of the annotation to a huge set of ortholog groups from the eggNOG database. In this database, each ortholog group is associated with functional annotations like Gene Ontology (GO) terms or KEGG pathways. When the protein sequence of a new gene is found to be very similar to one of these ortholog groups, the corresponding functional annotation is transferred to this new gene.\n\nInterProScan is a tool that analyses each protein sequence (or translated DNA sequence when nucleotide input is provided) from our annotation to determine if it contains one or several of the signatures from InterPro. When a protein contains a known signature, the corresponding functional annotation will be assigned to it by InterProScan.\n\n## Input dataset\nThis workflow requires a galaxy collection of type list with at least one file in fasta format.\n\n## Outputs for eggNOG Mapper\nThe output of this tool is a tabular file, where each line represents a gene from our annotation, with the functional annotation that was found by EggNOG-mapper. It includes a predicted protein name, GO terms, EC numbers, KEGG identifiers, etc.\n\n## Optional eggNOG annotation abundance tables\n\n**Generate eggNOG annotation abundance tables** is enabled by default. It runs the\nembedded [eggNOG-mapper Annotation Abundance Tables](../eggnog-mapper-abundance-tables)\nworkflow from IWC PR #1390 after eggNOG annotation. Disable this option to keep\nthe annotation and pathway-completeness outputs without generating count tables.\nIf **Run eggNOG + completeness calculation** is disabled, abundance extraction\nis skipped automatically, including when this new option remains enabled.\n\nThe branch publishes 14 per-annotation count tables (eggNOG OGs, COG categories,\nGO, EC, KEGG KOs, pathways, modules, reactions, reaction classes, BRITE, KEGG TC,\nCAZy, BiGG reactions and PFAMs), plus **eggNOG-mapper annotation abundance table**\ncombining all annotation types. Columns use the input collection identifiers;\nrows identify annotation terms. Missing annotations contribute to an\n`unannotated` row. Comma-separated terms and multi-letter COG categories are split\nbefore counting, as in the standalone summarization workflow.\n\nThese are annotation occurrence counts across the input files, not normalized\nabundances, read-mapping estimates or expression measurements. Skipped extraction\ndoes not produce usable abundance tables. Existing annotation and KEGG pathway\ncompleteness outputs are unchanged.\n\n## Outputs for Interproscan\nThe output of this tool is both a tabular file and an XML file. Both contain the same information, but the tabular one is more readable for a Human: each line represents a gene from our annotation, with the different domains and motifs that were found by InterProScan.\n\nEach line corresponds to a motif found in one of the annotated proteins. The most interesting columns are:\n\n- Column 1: the protein identifier\n- Column 5: the identifier of the signature that was found in the protein sequence\n- Column 4: the database where this signature comes from (InterProScan regroups several motif databases)\n- Column 6: the human-readable description of the motif\n- Columns 7 and 8: the position where the motif was found\n- Column 9: a score for the match (if available)\n- Columns 12 and 13: identifier of the signature integrated in InterPro (if available). Have a look at an example webpage for IPR036859 on InterPro.\n- The following columns contain various identifiers that were assigned to the protein based on the match with the signature (Gene ontology term, Reactome, \u2026)\n\n## Output for KEGG Pathways completeness\nThis tool calculates the completeness of metabolic pathways based on KEGG Orthologs (KOs) obtained from eggNOG annotations. In addition to estimating pathway completeness, the tool assigns each contig to the corresponding pathway and reports the pathway name and class. It also lists the KOs detected on the contig as well as the KOs that are missing for the pathway, enabling users to assess how close the pathway is to being complete.\n\n## Funding\n\nThis workflow was initially developed by Anthony Bretaudeau and then upgraded as part of the [**FAIRyMAGs** project](https://elixir-europe.org/how-we-work/scientific-programme/science/bfsp/fairymags), funded as a commissioned service of the [**Biodiversity, Food Security and Pathogens (BFSP) ELIXIR Scientific Programme 2024\u20132028**](https://elixir-europe.org/how-we-work/scientific-programme/science/bfsp).\n\nThe project was also supported by the **European Galaxy Server**, funded by the German Federal Ministry of Education and Research (BMBF; 031 A538A de.NBI-RBC) and the **Ministry of Science, Research and the Arts Baden-W\u00fcrttemberg (MWK)** within the framework of **LIBIS/de.NBI Freiburg**.\n"}}, "121": {"annotation": "Use uploaded long reads when supplied, otherwise sample-matched empty files. The skipped branch still needs a collection so its internal collection operations retain their shape.", "content_id": "toolshed.g2.bx.psu.edu/repos/iuc/pick_value/pick_value/0.2.0", "errors": null, "id": 121, "input_connections": {"style_cond|type_cond|pick_from_0|value": {"id": 1, "output_name": "output"}, "style_cond|type_cond|pick_from_1|value": {"id": 112, "output_name": "output"}}, "inputs": [], "label": "Supply sample-matched structure to optional long-read processing", "name": "Pick parameter value", "outputs": [{"name": "data_param", "type": "input"}], "position": {"left": 760, "top": 765}, "post_job_actions": {}, "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/pick_value/pick_value/0.2.0", "tool_shed_repository": {"changeset_revision": "b19e21af9c52", "name": "pick_value", "owner": "iuc", "tool_shed": "toolshed.g2.bx.psu.edu"}, "tool_state": "{\"style_cond\": {\"pick_style\": \"first\", \"__current_case__\": 0, \"type_cond\": {\"param_type\": \"data\", \"__current_case__\": 4, \"pick_from\": [{\"__index__\": 0, \"value\": {\"__class__\": \"ConnectedValue\"}}, {\"__index__\": 1, \"value\": {\"__class__\": \"ConnectedValue\"}}]}}, \"__page__\": 0, \"__rerun_remap_job_id__\": null}", "tool_uuid": null, "tool_version": "0.2.0", "type": "tool", "uuid": "7b6a2ab7-b988-4784-a71e-5bc4bbfc36ad", "when": null, "workflow_outputs": []}, "122": {"id": 122, "type": "tool", "name": "Filter null", "label": "Remove skipped long-read placeholders", "annotation": "Remove null datasets from the skipped long-read branch before selecting real reads or empty sample fallbacks.", "content_id": "__FILTER_NULL__", "tool_id": "__FILTER_NULL__", "tool_version": "1.0.0", "tool_state": "{\"input\": {\"__class__\": \"ConnectedValue\"}}", "input_connections": {"input": {"id": 124, "output_name": "data_param"}}, "inputs": [], "outputs": [], "position": {"left": 760, "top": 865}, "uuid": "3d4f600e-30f3-4813-bf77-619fa61da6fb", "when": null, "workflow_outputs": [], "post_job_actions": {}, "errors": null}, "123": {"annotation": "Use preprocessed long reads when available, otherwise retain sample-matched empty files. Host removal remains gated by the long-read selector.", "content_id": "toolshed.g2.bx.psu.edu/repos/iuc/pick_value/pick_value/0.2.0", "errors": null, "id": 123, "input_connections": {"style_cond|type_cond|pick_from_0|value": {"id": 104, "output_name": "collection_of_preprocessed_samples"}, "style_cond|type_cond|pick_from_1|value": {"id": 112, "output_name": "output"}}, "inputs": [], "label": "Bridge optional preprocessed long reads", "name": "Pick parameter value", "outputs": [{"name": "data_param", "type": "input"}], "position": {"left": 2000, "top": 780}, "post_job_actions": {}, "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/pick_value/pick_value/0.2.0", "tool_shed_repository": {"changeset_revision": "b19e21af9c52", "name": "pick_value", "owner": "iuc", "tool_shed": "toolshed.g2.bx.psu.edu"}, "tool_state": "{\"style_cond\": {\"pick_style\": \"first\", \"__current_case__\": 0, \"type_cond\": {\"param_type\": \"data\", \"__current_case__\": 4, \"pick_from\": [{\"__index__\": 0, \"value\": {\"__class__\": \"ConnectedValue\"}}, {\"__index__\": 1, \"value\": {\"__class__\": \"ConnectedValue\"}}]}}, \"__page__\": 0, \"__rerun_remap_job_id__\": null}", "tool_uuid": null, "tool_version": "0.2.0", "type": "tool", "uuid": "1be2125a-bf2b-47bf-921c-b3c93073ed89", "when": null, "workflow_outputs": []}, "124": {"annotation": "Pass the optional host-removal result to null filtering without making its input optional. Skipped placeholders are still removed before the final fallback merge.", "content_id": "toolshed.g2.bx.psu.edu/repos/iuc/p