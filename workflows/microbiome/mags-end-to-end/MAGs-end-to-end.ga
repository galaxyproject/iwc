    "102": {
      "type": "subworkflow",
      "name": "Remove host and contaminant reads from short reads",
      "label": "Remove host and contaminant reads from short reads",
      "tool_id": null,
      "tool_state": "{}",
      "input_connections": {
        "Short-reads": {
          "id": 101,
          "output_name": "fastp trimmed reads",
          "input_subworkflow_step_id": 1
        },
        "Choose Reference Genome": {
