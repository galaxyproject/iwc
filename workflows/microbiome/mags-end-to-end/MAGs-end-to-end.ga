": \"table\", \"section_name\": \" CoverM Bin coverage\", \"title\": null, \"description\": null, \"xlab\": null, \"ylab\": null, \"input\": {\"__class__\": \"ConnectedValue\"}}}], \"title\": \"\", \"__page__\": 0, \"__rerun_remap_job_id__\": null}", "tool_uuid": null, "tool_version": "1.35+galaxy2", "type": "tool", "uuid": "1ee3626f-8b00-4d4c-a574-e1e310788110", "when": null, "workflow_outputs": [{"label": "Full MultiQC Report", "output_name": "html_report", "uuid": "cdf15c25-b19a-43f2-9956-7a3a91ecbac8"}]}}, "tags": ["name:FAIRyMAGs"], "uuid": "e81af5cc-6bb2-4db6-a173-dd8a72eebc35", "version": 1, "release": "0.9"}}, "115": {"annotation": "Convert the Yes/No taxonomy selection into a boolean that enables the taxonomy workflow only when requested.", "content_id": null, "errors": null, "id": 115, "input_connections": {"input_param_type|input_param": {"id": 32, "output_name": "output"}}, "inputs": [], "label": "Taxonomy annotation gate", "name": "Taxonomy annotation gate", "outputs": [], "position": {"left": 3620, "top": 365}, "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/map_param_value/map_param_value/0.2.0", "tool_state": "{\"input_param_type\": {\"type\": \"text\", \"__current_case__\": 0, \"input_param\": {\"__class__\": \"ConnectedValue\"}, \"mappings\": [{\"__index__\": 0, \"from\": \"Yes\", \"to\": \"True\"}, {\"__index__\": 1, \"from\": \"No\", \"to\": \"False\"}]}, \"output_param_type\": \"boolean\", \"unmapped\": {\"on_unmapped\": \"default\", \"__current_case__\": 2, \"default_value\": \"False\"}, \"__page__\": 0, \"__rerun_remap_job_id__\": null}", "tool_version": null, "type": "tool", "uuid": "cf4a3c2a-a09d-41ea-bd0d-916a939bb05e", "when": null, "workflow_outputs": []}, "116": {"annotation": "Convert the Yes/No genome annotation selection into a boolean that enables the genome annotation workflow only when requested.", "content_id": null, "errors": null, "id": 116, "input_connections": {"input_param_type|input_param": {"id": 36, "output_name": "output"}}, "inputs": [], "label": "Genome annotation gate", "name": "Genome annotation gate", "outputs": [], "position": {"left": 3620, "top": 565}, "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/map_param_value/map_param_value/0.2.0", "tool_state": "{\"input_param_type\": {\"type\": \"text\", \"__current_case__\": 0, \"input_param\": {\"__class__\": \"ConnectedValue\"}, \"mappings\": [{\"__index__\": 0, \"from\": \"Yes\", \"to\": \"True\"}, {\"__index__\": 1, \"from\": \"No\", \"to\": \"False\"}]}, \"output_param_type\": \"boolean\", \"unmapped\": {\"on_unmapped\": \"default\", \"__current_case__\": 2, \"default_value\": \"False\"}, \"__page__\": 0, \"__rerun_remap_job_id__\": null}", "tool_version": null, "type": "tool", "uuid": "808a3c7b-a457-4757-80b7-6ad8553d7392", "when": null, "workflow_outputs": []}, "117": {"annotation": "Convert the Yes/No functional annotation selection into a boolean that enables the functional annotation workflow only when requested.", "content_id": null, "errors": null, "id": 117, "input_connections": {"input_param_type|input_param": {"id": 41, "output_name": "output"}}, "inputs": [], "label": "Functional annotation gate", "name": "Functional annotation gate", "outputs": [], "position": {"left": 3620, "top": 765}, "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/map_param_value/map_param_value/0.2.0", "tool_state": "{\"input_param_type\": {\"type\": \"text\", \"__current_case__\": 0, \"input_param\": {\"__class__\": \"ConnectedValue\"}, \"mappings\": [{\"__index__\": 0, \"from\": \"Yes\", \"to\": \"True\"}, {\"__index__\": 1, \"from\": \"No\", \"to\": \"False\"}]}, \"output_param_type\": \"boolean\", \"unmapped\": {\"on_unmapped\": \"default\", \"__current_case__\": 2, \"default_value\": \"False\"}, \"__page__\": 0, \"__rerun_remap_job_id__\": null}", "tool_version": null, "type": "tool", "uuid": "467427cd-6c87-4c65-89d4-fa65c810b349", "when": null, "workflow_outputs": []}, "118": {"type": "subworkflow", "name": "Annotate MAG taxonomy", "label": "Annotate MAG taxonomy", "tool_id": null, "tool_state": "{}", "input_connections": {"Sequence collection": {"id": 114, "output_name": "Dereplicated Bins", "input_subworkflow_step_id": 0}, "GTDB-Tk Database": {"id": 33, "output_name": "output", "input_subworkflow_step_id": 1}, "MAGs taxonomic classification with kMetaShot (optional)": {"id": 34, "output_name": "output", "input_subworkflow_step_id": 2}, "kMetaShot Database": {"id": 35, "output_name": "output", "input_subworkflow_step_id": 3}, "when": {"id": 115, "output_name": "output_param_boolean"}}, "inputs": [], "outputs": [], "annotation": "Embedded workflow: classifies the MAGs with GTDB-Tk (and optionally kMetaShot) and summarises the results.", "when": "$(inputs.when)", "id": 118, "uuid": "d534fabf-ca2d-4bc3-8768-5be6be8b5590", "position": {"left": 3620, "top": 465}, "workflow_outputs": [{"label": "GTDB-Tk taxonomy summary", "output_name": "GTDB-Tk summary files", "uuid": "e559aad0-7903-4b4a-897a-4e4b163a410b"}, {"label": "GTDB to NCBI taxonomy mapping", "output_name": "full GTDB to NCBI mapping", "uuid": "ff86d318-31d8-4b40-b61d-1acd0ce64014"}, {"label": "Taxonomy annotation report", "output_name": "MultiQC HTML report", "uuid": "62400e5a-daf6-4d1c-82ae-1faf2d5d69cd"}], "subworkflow": {"a_galaxy_workflow": "true", "annotation": "This workflow performs taxonomic classification of an input sequence collection (e.g., bins from SemiBin2 or MetaBat) using GTDB-Tk and kMetaShot (optional). GTDB-Tk taxonomy is mapped to NCBI taxIDs and names to reconcile differences between NCBI/GTDB taxonomies.\n", "comments": [], "creator": [{"class": "Person", "identifier": "https://orcid.org/0000-0002-9356-5224", "name": "Giuseppe Defazio"}, {"class": "Person", "identifier": "https://orcid.org/0000-0003-2982-388X", "name": "Paul Zierep"}, {"class": "Person", "identifier": "https://orcid.org/0000-0001-9852-1987", "name": "B\u00e9r\u00e9nice Batut"}, {"class": "Person", "identifier": "https://orcid.org/0009-0004-0382-2023", "name": "Santino Faack"}, {"class": "Organization", "name": "FAIRyMAGs consortium", "url": "https://github.com/usegalaxy-eu/FAIRyMAGs"}], "format-version": "0.1", "license": "MIT", "name": "MAGs taxonomy annotation", "readme": "# MAGs Taxonomy Annotation\n\nThis workflow generates taxonomic annotations for MAGs using GTDB-Tk and kMetaShot. With the integration of additional tools, MAGs also receive corresponding taxonomic classifications from NCBI.\n\nThis workflow can be used on its own or integrated into other workflows. For example, it is part of a **suite of workflows for end-to-end metagenome-assembled genome (MAG) generation** (check [FAIRyMAGs repository](https://github.com/usegalaxy-eu/FAIRyMAGs) for the complete workflow suite and its capabilities).\nA dedicated [learning pathway](https://galaxyproject.github.io/training-material/learning-pathways/mags.html) provides detailed guidance on how to use this workflow.\n\n## Workflow logic\nThe workflow first runs GTDB-Tk and kMetaShot (optional) to generate a summary file. From this file, it extracts the GTDB lineage for each MAG and reformats it so that the GTDB\u2013NCBI mapping tool can translate GTDB names into their corresponding NCBI names. These NCBI names are then passed to another tool, which resolves them into the corresponding NCBI taxIDs.\n\nIn parallel, an additional text-processing step extracts the taxonomic rank from the GTDB-Tk annotation. Finally, all collected information is merged into a single file with the following five columns:\n\n- BinID\n- GTDB name\n- Taxonomic rank\n- NCBI name\n- NCBI taxID\n\n## Input\nThis workflow takes a dataset collection (a Galaxy collection of type list) containing MAGs produced by binners (e.g. MetaBAT2, dRep) in FASTA format.\n\n## Output\nThis workflow produces the following main outputs: \n\n- GTDB-Tk summary file(s)\n- kMetaSHot summary file (optional)\n- GTDB\u2013NCBI mapping file(s)\n- NCBI name-to-taxID mapping file(s)\n- A complete merged table containing all mappings\n- MultiQC HTML report with GTDB-Tk and the full mapping table as input as well as kMetaShot if run\n\n## Funding\n\nThis workflow was developed as part of the [**FAIRyMAGs** project](https://elixir-europe.org/how-we-work/scientific-programme/science/bfsp/fairymags), funded as a commissioned service of the [**Biodiversity, Food Security and Pathogens (BFSP) ELIXIR Scientific Programme 2024\u20132028**](https://elixir-europe.org/how-we-work/scientific-programme/science/bfsp).\n\nThe project was also supported by the **European Galaxy Server**, funded by the German Federal Ministry of Education and Research (BMBF; 031 A538A de.NBI-RBC) and the **Ministry of Science, Research and the Arts Baden-W\u00fcrttemberg (MWK)** within the framework of **LIBIS/de.NBI Freiburg**.", "report": {"markdown": "\n# Workflow Execution Report\n\n## Workflow Inputs\n```galaxy\ninvocation_inputs()\n```\n\n## Workflow Outputs\n```galaxy\ninvocation_outputs()\n```\n\n## Workflow\n```galaxy\nworkflow_display()\n```\n"}, "steps": {"0": {"annotation": "Provide a collection of MAGs from dRep or another binning tool.", "content_id": null, "errors": null, "id": 0, "input_connections": {}, "inputs": [{"description": "Provide a collection of MAGs from dRep or another binning tool.", "name": "Sequence collection"}], "label": "Sequence collection", "name": "Input dataset collection", "outputs": [], "position": {"left": 0, "top": 0}, "tool_id": null, "tool_state": "{\"optional\": false, \"tag\": null, \"collection_type\": \"list\", \"fields\": null, \"column_definitions\": null}", "tool_version": null, "type": "data_collection_input", "uuid": "ca24885e-e953-41d0-8409-3be81376e14d", "when": null, "workflow_outputs": []}, "1": {"annotation": "GTDB-Tk Database used for Bin Taxonomy  Classification", "content_id": null, "errors": null, "id": 1, "input_connections": {}, "inputs": [{"description": "GTDB-Tk Database used for Bin Taxonomy  Classification", "name": "GTDB-Tk Database"}], "label": "GTDB-T