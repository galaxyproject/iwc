    "2": {
      "annotation": "Build the panel index ONCE and reuse it for every specimen.\nWith bwa_mem and a history reference, Galaxy rebuilds the index inside every mapping job -- 187 redundant builds of the same 11 kb panel for a 187-specimen cohort. The index is a property of the panel, not of the specimen, so it belongs upstream of the fan-out. bwa_mem2's mapper accepts a bwa_mem2_index dataset directly, which makes this expressible.",
      "content_id": "toolshed.g2.bx.psu.edu/repos/iuc/bwa_mem2/bwa_mem2_idx/2.3+galaxy0",
      "errors": null,
      "id": 2,
      "input_connections": {
        "reference": {
          "id": 1,
          "output_name": "output"
        }
      },
      "inputs": [],
