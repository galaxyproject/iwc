{
    "name": "PyEuk amplicon panel inference",
    "a_galaxy_workflow": "true",
    "format-version": "0.1",
    "annotation": "This workflow maps paired-end targeted-amplicon reads to a reference genome with bwa-mem2, keeps MAPQ>=20 proper pairs, and calls coverage peaks with PyEuk derive-panel to generate an amplicon panel FASTA (plus a peak BED and a per-peak QC table) for use with the PyEuk amplicon haplotype typing workflow when no curated panel is available.",
    "tags": [
        "name:amplicon",
        "amplicon",
        "genotyping",
        "typing",
        "amplicon-panel",
        "eukaryotic-pathogens"
    ],
    "license": "MIT",
    "release": "0.1",
    "uuid": "334acc4a-0e7c-4d9d-b886-00d1efb16645",
    "creator": [
        {
            "name": "Anton Nekrutenko",
            "identifier": "https://orcid.org/0000-0002-5987-8032",
            "class": "Person"
        },
        {
            "name": "Sergei Pond",
            "identifier": "https://orcid.org/0000-0003-4817-4029",
            "class": "Person"
        }
    ],
    "comments": [],
    "steps": {
        "0": {
            "id": 0,
            "name": "Paired-end reads",
            "type": "data_collection_input",
            "label": "Paired-end reads",
            "annotation": "Adapter/quality-trimmed paired FASTQ, one pair per specimen. A representative subset is enough; derive-panel samples a fixed number of BAMs.",
            "tool_state": "{\"name\": \"Paired-end reads\", \"collection_type\": \"list:paired\"}",
            "position": {
