            "id": 1,
            "name": "Reference genome",
            "type": "data_input",
            "label": "Reference genome",
            "annotation": "The reference genome the reads are mapped to (not a panel). derive-panel extracts each coverage peak's sequence from it.",
            "tool_state": "{\"name\": \"Reference genome\", \"format\": [\"fasta\"]}",
            "position": {
                "top": 290,
                "left": 0
            },
            "input_connections": {},
