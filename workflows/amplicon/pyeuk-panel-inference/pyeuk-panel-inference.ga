        },
        "2": {
            "id": 2,
            "name": "Minimum peak depth fraction",
            "type": "parameter_input",
            "label": "Minimum peak depth fraction",
            "annotation": "A coverage peak must reach this fraction of the run's maximum depth (0-1). The effective depth threshold is the larger of this fraction times the maximum depth and the minimum peak depth. Being relative to the run's own maximum, it rarely needs retuning; raise it to drop weak off-target peaks, lower it to keep low-yield amplicons.",
            "tool_state": "{\"name\": \"Minimum peak depth fraction\", \"parameter_type\": \"float\", \"optional\": false, \"default\": 0.01}",
            "position": {
                "top": 200,
                "left": 600
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Minimum peak depth fraction",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "641aeef1-9e6a-4aaa-b580-650673351f9a"
        },
        "3": {
            "id": 3,
            "name": "Minimum peak depth",
            "type": "parameter_input",
            "label": "Minimum peak depth",
            "annotation": "Absolute depth floor (reads, at least 1) a coverage peak must clear, whatever the depth fraction gives. Raise it for deep runs with off-target background; lower it for shallow runs.",
            "tool_state": "{\"name\": \"Minimum peak depth\", \"parameter_type\": \"integer\", \"optional\": false, \"default\": 30}",
            "position": {
                "top": 300,
                "left": 600
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Minimum peak depth",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "e139b240-6a0e-431a-8455-8d21ab6e9eea"
        },
        "4": {
            "id": 4,
            "name": "Minimum peak length",
            "type": "parameter_input",
            "label": "Minimum peak length",
            "annotation": "Peaks shorter than this many bases (at least 1) are discarded. Keep it below the shortest expected amplicon.",
            "tool_state": "{\"name\": \"Minimum peak length\", \"parameter_type\": \"integer\", \"optional\": false, \"default\": 80}",
            "position": {
                "top": 400,
                "left": 600
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Minimum peak length",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "c5291a77-2ce7-4975-9183-1ab605785d5d"
        },
        "5": {
            "id": 5,
            "name": "Peak merge gap",
            "type": "parameter_input",
            "label": "Peak merge gap",
            "annotation": "Peaks separated by fewer than this many bases (0 or more) are joined into one panel entry, bridging a coverage dip in the middle of an amplicon. Keep it below the spacing of neighbouring amplicons, or they merge into a single entry.",
            "tool_state": "{\"name\": \"Peak merge gap\", \"parameter_type\": \"integer\", \"optional\": false, \"default\": 25}",
            "position": {
                "top": 500,
                "left": 600
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Peak merge gap",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "b6805298-668c-4e03-8fdd-b2fcf437c033"
        },
        "6": {
            "id": 6,
            "name": "Peak padding",
            "type": "parameter_input",
            "label": "Peak padding",
            "annotation": "Extend each peak by this many bases (0 or more) at both ends before its sequence is taken from the genome. 0 keeps exactly the covered region.",
            "tool_state": "{\"name\": \"Peak padding\", \"parameter_type\": \"integer\", \"optional\": false, \"default\": 0}",
            "position": {
