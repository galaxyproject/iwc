{
    "name": "PyEuk amplicon panel inference",
    "a_galaxy_workflow": "true",
    "format-version": "0.1",
    "annotation": "This workflow maps paired-end targeted-amplicon reads to a reference genome with bwa-mem2, keeps MAPQ>=20 proper pairs, and calls coverage peaks with PyEuk derive-panel to generate an amplicon panel FASTA (plus a peak BED and a per-peak QC table) for use with the PyEuk amplicon haplotype typing workflow when no curated panel is available.",
    "tags": [],
    "license": "MIT",
    "release": "0.1",
