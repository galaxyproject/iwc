{
    "name": "PyEuk amplicon haplotype typing",
    "a_galaxy_workflow": "true",
    "format-version": "0.1",
    "annotation": "This workflow performs read-level haplotype typing of a cohort of targeted-amplicon specimens without a curated allele catalogue: paired-end reads are mapped to an amplicon panel with bwa-mem2 and filtered, analysis windows are derived from the cohort, per-specimen haplotypes are called from reads spanning each window and assembled into a specimen-by-haplotype sheet, and PyEuk computes a distance matrix and a cluster sweep to generate clusters and an HTML report.",
    "tags": [],
    "license": "MIT",
    "release": "0.1",
    "uuid": "b448fd95-0ba7-46c6-bbb4-dd613edd752e",
    "creator": [
        {
            "name": "Anton Nekrutenko",
            "identifier": "https://orcid.org/0000-0002-5987-8032",
            "class": "Person"
        },
        {
            "name": "Sergei Pond",
            "identifier": "https://orcid.org/0000-0003-4817-4029",
            "class": "Person"
        }
    ],
    "comments": [],
    "steps": {
        "0": {
            "id": 0,
            "name": "Paired-end reads",
            "type": "data_collection_input",
            "label": "Paired-end reads",
            "annotation": "Adapter/quality-trimmed paired FASTQ, one pair per specimen. The list element identifier is the specimen id: it becomes column 1 of the calls and the row id of the sheet, so it must match [A-Za-z0-9_.-]+.",
            "tool_state": "{\"name\": \"Paired-end reads\", \"collection_type\": \"list:paired\"}",
            "position": {
                "top": 170,
                "left": 300
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Paired-end reads",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "02dc4319-c8f6-45ce-b002-ff864c704bc7"
        },
        "1": {
            "id": 1,
            "name": "Amplicon panel",
            "type": "data_input",
            "label": "Amplicon panel",
            "annotation": "The amplicon panel FASTA, used both as the mapping reference and as the reference the haplotype strings are described against. A haplotype name is a difference from this sequence, so a different panel renames every haplotype.",
            "tool_state": "{\"name\": \"Amplicon panel\", \"format\": [\"fasta\"]}",
            "position": {
                "top": 290,
                "left": 0
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Amplicon panel",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "6d1f386d-51ed-4810-a27d-bc72590b4e57"
        },
        "2": {
            "id": 2,
            "name": "Maximum window length",
            "type": "parameter_input",
            "label": "Maximum window length",
            "annotation": "Upper bound on the analysis window length in bp; 0 means no cap. The default of 100 bp resolved every mixture on a Cryptosporidium titration where 250 bp windows did not. Window length trades linkage against sequencing error: shorter windows are spanned by more reads and resolve minor components of mixtures more reliably.",
            "tool_state": "{\"name\": \"Maximum window length\", \"parameter_type\": \"integer\", \"default\": 100}",
            "position": {
                "top": 20,
                "left": 20
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Maximum window length",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "99e77572-92f2-428d-9a9f-997622900967"
        },
        "3": {
            "id": 3,
            "name": "Minimum spanning reads per window",
            "type": "parameter_input",
            "label": "Minimum spanning reads per window",
            "annotation": "Minimum total number of reads spanning a window end to end for the window to be called at all. This is the first gate a window has to clear. It is harder on mixed specimens: k co-infecting genotypes split the spanning reads k ways. The default was calibrated on a Cyclospora cohort; re-check it for panels with different amplicon lengths or depths.",
            "tool_state": "{\"name\": \"Minimum spanning reads per window\", \"parameter_type\": \"integer\", \"default\": 30}",
            "position": {
                "top": 30,
                "left": 30
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Minimum spanning reads per window",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "d89be402-4048-45bd-b002-1e84242d5972"
        },
        "4": {
            "id": 4,
            "name": "Minimum haplotype frequency",
            "type": "parameter_input",
            "label": "Minimum haplotype frequency",
            "annotation": "Minimum haplotype frequency, the fraction of spanning reads carrying an entire haplotype string (not a per-site allele frequency). Lower it (e.g. 0.005) to detect low-frequency mixture components, and rely on the minimum reads per haplotype to suppress noise.",
            "tool_state": "{\"name\": \"Minimum haplotype frequency\", \"parameter_type\": \"float\", \"default\": 0.05}",
            "position": {
                "top": 40,
                "left": 40
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Minimum haplotype frequency",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "e7e2f745-d612-4b02-9623-9121d97eb05d"
        },
        "5": {
            "id": 5,
            "name": "Minimum reads per haplotype",
            "type": "parameter_input",
            "label": "Minimum reads per haplotype",
            "annotation": "Minimum supporting reads per haplotype. This is the noise control that should do the work when the minimum haplotype frequency is lowered.",
            "tool_state": "{\"name\": \"Minimum reads per haplotype\", \"parameter_type\": \"integer\", \"default\": 10}",
            "position": {
                "top": 50,
                "left": 50
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Minimum reads per haplotype",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "e8292cd7-282f-4687-93e7-dc330811526c"
        },
        "6": {
            "id": 6,
            "name": "Project distances onto the positive semidefinite cone",
            "type": "parameter_input",
            "label": "Project distances onto the positive semidefinite cone",
            "annotation": "Project the distance matrix onto the positive semidefinite cone by Gram double centering, so distances embed in Euclidean space as Ward linkage assumes. This compresses the closest pairs, so it is off by default; consider enabling it together with the distance tree cut method.",
            "tool_state": "{\"name\": \"Project distances onto the positive semidefinite cone\", \"parameter_type\": \"boolean\", \"default\": false}",
            "position": {
                "top": 60,
                "left": 60
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Project distances onto the positive semidefinite cone",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "20ce3bb2-85d9-4b6a-9e68-c2fb07358c82"
        },
        "7": {
            "id": 7,
            "name": "Tree cut method",
            "type": "parameter_input",
            "label": "Tree cut method",
            "annotation": "\"count\" splits the cohort into k groups, with k chosen from the largest merge-height gap (suited to a closed investigation where every specimen belongs somewhere). \"distance\" cuts at a fixed dissimilarity and returns specimens with no near neighbour as singletons (suited to surveillance, where most cases are unrelated).",
            "tool_state": "{\"name\": \"Tree cut method\", \"parameter_type\": \"text\", \"default\": \"count\", \"restrictions\": [\"count\", \"distance\"]}",
            "position": {
                "top": 70,
                "left": 70
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Tree cut method",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "9a35e5c4-9667-4609-ad19-6ec2d01774c3"
        },
        "8": {
            "id": 8,
            "name": "Linkage distance threshold",
            "type": "parameter_input",
            "label": "Linkage distance threshold",
            "annotation": "Dissimilarity at which to cut when the tree cut method is \"distance\". Leave unset to calibrate it from the data; the tool reports the value it used.",
            "tool_state": "{\"name\": \"Linkage distance threshold\", \"parameter_type\": \"float\", \"optional\": true}",
            "position": {
                "top": 80,
                "left": 80
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Linkage distance threshold",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "d3c37e95-b513-40bd-a3ed-34e5f8d06e40"
        },
        "9": {
            "id": 9,
            "name": "Minimum locus completeness",
            "type": "parameter_input",
            "label": "Minimum locus completeness",
            "annotation": "Minimum fraction of loci a specimen must have called to enter the distance matrix. Panel-dependent. Raise it when a low-completeness tail of specimens produces distances pinned at the no-shared-data ceiling.",
            "tool_state": "{\"name\": \"Minimum locus completeness\", \"parameter_type\": \"float\", \"default\": 0.1}",
            "position": {
                "top": 90,
                "left": 90
            },
            "input_connections": {},
            "inputs": [
                {
                    "name": "Minimum locus completeness",
                    "description": ""
                }
            ],
            "outputs": [],
            "workflow_outputs": [],
            "post_job_actions": {},
            "uuid": "4b671f2c-ddd1-42f1-8194-2439c2d52b36"
        },
