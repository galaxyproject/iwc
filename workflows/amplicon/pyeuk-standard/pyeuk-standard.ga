{
  "a_galaxy_workflow": "true",
  "annotation": "PyEuk Standard: FASTQs + amplicon panel -> windows -> haplotypes -> sheet -> cluster sweep. Portable multilocus typing with a sweep output (count range + confidence + stable cores).",
  "comments": [],
  "creator": [
    {
      "class": "Person",
      "name": "Anton Nekrutenko"
    },
    {
      "class": "Person",
      "name": "Sergei Pond"
    }
  ],
  "format-version": "0.1",
  "license": "MIT",
  "name": "Read-level haplotype typing (PyEuk 0.7.0 unified)",
  "steps": {
    "0": {
      "annotation": "Adapter/quality-trimmed paired FASTQ, one pair per specimen. The list element identifier IS the specimen id: it becomes column 1 of the calls and the row id of the sheet, so it must match [A-Za-z0-9_.-]+.",
      "content_id": null,
      "errors": null,
      "id": 0,
      "input_connections": {},
      "inputs": [
        {
          "description": "Adapter/quality-trimmed paired FASTQ, one pair per specimen. The list element identifier IS the specimen id: it becomes column 1 of the calls and the row id of the sheet, so it must match [A-Za-z0-9_.-]+.",
          "name": "reads"
        }
      ],
      "label": "reads",
      "name": "Input dataset collection",
      "outputs": [],
      "position": {
        "left": 0,
        "top": 0
      },
      "tool_id": null,
      "tool_state": "{\"optional\": false, \"tag\": null, \"collection_type\": \"list:paired\", \"fields\": null, \"column_definitions\": null}",
      "tool_version": null,
      "type": "data_collection_input",
      "uuid": "e79822d3-2e9f-4212-8dc7-1d59518329a9",
      "when": null,
      "workflow_outputs": []
    },
    "1": {
      "annotation": "Minimum TOTAL fully-spanning reads for a window to be called at all. Applied before any haplotype is considered, so it is the first gate a window has to clear -- and on the Cyclospora 2018 cohort it was the binding one. Measured by holding the BAMs and windows fixed and sweeping only this value: min_span 24-42 is a flat plateau at ARI 0.9737 against the vendor labels with a single specimen misassigned, and between 42 and 44 it falls to 0.7536 with ten misassigned. The previous default of 50 sat on the wrong side of that cliff. Note this gate is harder on MIXED specimens than clonal ones: k co-infecting genotypes split the spanning reads k ways, so a mixture needs k times the depth of a clonal sample to clear the same value. 30 is a Cyclospora result, not a universal constant -- on a cohort with different amplicon lengths or insert sizes, sweep it again rather than assuming it transfers.",
      "content_id": null,
      "errors": null,
      "id": 1,
      "input_connections": {},
      "inputs": [
        {
          "description": "Minimum TOTAL fully-spanning reads for a window to be called at all. Applied before any haplotype is considered, so it is the first gate a window has to clear -- and on the Cyclospora 2018 cohort it was the binding one. Measured by holding the BAMs and windows fixed and sweeping only this value: min_span 24-42 is a flat plateau at ARI 0.9737 against the vendor labels with a single specimen misassigned, and between 42 and 44 it falls to 0.7536 with ten misassigned. The previous default of 50 sat on the wrong side of that cliff. Note this gate is harder on MIXED specimens than clonal ones: k co-infecting genotypes split the spanning reads k ways, so a mixture needs k times the depth of a clonal sample to clear the same value. 30 is a Cyclospora result, not a universal constant -- on a cohort with different amplicon lengths or insert sizes, sweep it again rather than assuming it transfers.",
          "name": "min_span"
        }
      ],
      "label": "min_span",
      "name": "Input parameter",
      "outputs": [],
      "position": {
        "left": 10,
        "top": 10
      },
      "tool_id": null,
      "tool_state": "{\"default\": 30, \"validators\": [], \"parameter_type\": \"integer\", \"optional\": false}",
      "tool_version": null,
      "type": "parameter_input",
      "uuid": "cb3dc40f-7fc1-4ca8-b9ba-0666f526dc93",
      "when": null,
      "workflow_outputs": []
    },
    "2": {
      "annotation": "Minimum HAPLOTYPE frequency -- the fraction of spanning reads carrying an entire string. Exposed because the right value is dataset-dependent and the default is not general. 0.05 was carried over from a Cryptosporidium titration whose minor components were 25-75%, so anything below the gate was never exercised there. On a cohort containing 1% components, 0.05 makes them undetectable BY CONSTRUCTION -- every observed frequency then piles up just above the gate. Set 0.005 or lower to probe a low-frequency detection floor, and let min_reads suppress noise instead.",
      "content_id": null,
      "errors": null,
      "id": 2,
      "input_connections": {},
      "inputs": [
        {
          "description": "Minimum HAPLOTYPE frequency -- the fraction of spanning reads carrying an entire string. Exposed because the right value is dataset-dependent and the default is not general. 0.05 was carried over from a Cryptosporidium titration whose minor components were 25-75%, so anything below the gate was never exercised there. On a cohort containing 1% components, 0.05 makes them undetectable BY CONSTRUCTION -- every observed frequency then piles up just above the gate. Set 0.005 or lower to probe a low-frequency detection floor, and let min_reads suppress noise instead.",
          "name": "min_freq"
        }
      ],
      "label": "min_freq",
      "name": "Input parameter",
      "outputs": [],
      "position": {
        "left": 20,
        "top": 20
      },
      "tool_id": null,
      "tool_state": "{\"default\": 0.05, \"validators\": [], \"parameter_type\": \"float\", \"optional\": false}",
      "tool_version": null,
      "type": "parameter_input",
      "uuid": "06cac662-4b4e-405a-baba-0b8908c7b036",
      "when": null,
      "workflow_outputs": []
    },
    "3": {
      "annotation": "Minimum supporting reads per haplotype. This is the noise control that should do the work when min_freq is lowered: at 10 reads a haplotype needs real support regardless of how small a fraction it represents.",
      "content_id": null,
      "errors": null,
      "id": 3,
      "input_connections": {},
      "inputs": [
