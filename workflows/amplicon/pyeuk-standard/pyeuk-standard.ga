    "7": {
      "annotation": "Minimum fraction of loci a specimen must have called to enter the distance matrix. Panel-dependent, so there is no universal value. Raise it when the cohort has a low-completeness tail that would otherwise produce distances pinned at the engine's no-shared-data ceiling: on CDC AmpliSeq five specimens sit at 0.46-0.48 while the median is 0.945, and they generate six pairs at distance 1.0 against a real maximum of 0.2888. Four of those five are the specimens the source publication itself marks as insufficient for clustering.",
      "content_id": null,
      "errors": null,
      "id": 7,
      "input_connections": {},
      "inputs": [
        {
          "description": "Minimum fraction of loci a specimen must have called to enter the distance matrix. Panel-dependent, so there is no universal value. Raise it when the cohort has a low-completeness tail that would otherwise produce distances pinned at the engine's no-shared-data ceiling: on CDC AmpliSeq five specimens sit at 0.46-0.48 while the median is 0.945, and they generate six pairs at distance 1.0 against a real maximum of 0.2888. Four of those five are the specimens the source publication itself marks as insufficient for clustering.",
          "name": "min_completeness"
        }
      ],
      "label": "min_completeness",
