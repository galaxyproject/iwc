---
// Footer component

// Astro's HTML compression turns the line break before inline text into "\n" but the one
// before an expression into a space. Carrying the break here keeps the page's bytes what
// they were when the blurb was written inline.
const blurb = `\n${__SITE_FOOTER_BLURB__}`;
---

<footer class="bg-ebony-clay text-white py-6 px-6 mt-auto">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between gap-4 text-sm">
        <div class="border-l-4 border-hokey-pokey-500 pl-3">
            <span class="font-bold">{__SITE_NAME__}</span>
            <span class="text-chicago-300"> · </span>
            <span class="text-chicago-300">{blurb} Part of the
                <a
                    href="https://galaxyproject.org"
                    class="text-chicago-200 underline hover:text-hokey-pokey"
                    target="_blank"
                    rel="noopener"
                    >Galaxy Project</a
                >.
            </span>
        </div>
        <p class="text-chicago-400">Workflows are licensed under their respective open source licenses.</p>
    </div>
</footer>
