---
import BaseLayout from "../layouts/BaseLayout.astro";
import { IWC_SITE_URL } from "../utils";
import IWCHeader from "../components/IWCHeader.astro";
import HeroSection from "../components/HeroSection.vue";
import WorkflowGrid from "../components/WorkflowGrid.vue";
import FilterSidebar from "../components/FilterSidebar.vue";
import MobileFilterSheet from "../components/MobileFilterSheet.vue";
import searchIndexData from "../../public/data/search-index.json";

const POPULAR_WORKFLOW_TRS_IDS = __SITE_FEATURED_TRS_IDS__;

// Each island serializes its own copy of its props, so the hero only gets the
// entries it shows rather than the whole index.
const popularWorkflows = searchIndexData.filter((w) => POPULAR_WORKFLOW_TRS_IDS.includes(w.trsID));
---

<BaseLayout
    title={__SITE_NAME__}
    description={__SITE_HOME_DESCRIPTION__}
    ogTitle={__SITE_NAME__}
    ogDescription={__SITE_OG_DESCRIPTION__}
    ogImage={`${IWC_SITE_URL}/iwc_logo.png`}
    ogType="website"
    twitterCard="summary"
    twitterTitle={__SITE_NAME__}
    twitterDescription={__SITE_OG_DESCRIPTION__}
    twitterImage={`${IWC_SITE_URL}/iwc_logo.png`}
    hasHero={true}>
    <IWCHeader slot="header" />

    <div slot="hero">
        <HeroSection popularTrsIds={POPULAR_WORKFLOW_TRS_IDS} workflows={popularWorkflows} client:load />
    </div>

    <div slot="content" class="flex flex-col md:flex-row gap-6">
        <FilterSidebar workflows={searchIndexData} client:load />

        <div class="flex-1 min-w-0">
            <MobileFilterSheet workflows={searchIndexData} client:load />

            <div id="category-description" class="w-full my-4 p-4 bg-white rounded-lg shadow-md" style="display: none">
                <h2 id="category-title" class="text-xl font-semibold mb-4"></h2>
                <div id="category-content" class="prose !max-w-none"></div>
            </div>

            <WorkflowGrid workflows={searchIndexData} client:load />
        </div>
    </div>
</BaseLayout>
